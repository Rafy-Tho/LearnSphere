# Backend environment variables. Copy to `.env` and fill in real values.
# Never commit `.env`.

# Server
PORT=5000
NODE_ENV=development
# Trusted reverse-proxy hops (integer) or comma-separated CIDRs. Default 1.
TRUST_PROXY=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_platform

# Session
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_NAME=lms_session

# Allowed client origins (learner frontend, admin dashboard)
CLIENT_URL_1=http://localhost:5173
CLIENT_URL_2=http://localhost:5174

# Email (Brevo)
BREVO_API_KEY=
SENDER_EMAIL=no-reply@example.com

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
