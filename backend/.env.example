# Backend environment variables. Copy to `.env` and fill in real values.
# Never commit `.env`.

# Server
PORT=5000
NODE_ENV=development
# Trusted reverse-proxy hops (integer) or comma-separated CIDRs. Default 1.
TRUST_PROXY=1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learning_platform

# Session
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_NAME=lms_session

# Allowed client origins (learner frontend, admin dashboard)
CLIENT_URL_1=http://localhost:5173
CLIENT_URL_2=http://localhost:5174

# Email (Hostinger Mail API)
# Create a token in hPanel > Agentic Mail > API access, scoped to the
# noreply@ mailbox. Keep this server-side only; never expose it to the frontend.
HOSTINGER_MAIL_API_KEY=
# Resource ID (AC...) of the mailbox the token is authorized to send from.
# The From address is the mailbox itself (noreply@learnsphere.rafytho.com).
HOSTINGER_MAIL_MAILBOX_ID=
# Display name shown as "LearnSphere <noreply@...>". Optional, defaults to LearnSphere.
HOSTINGER_MAIL_DISPLAY_NAME=LearnSphere
# Base URL override. Optional, defaults to https://api.mail.hostinger.com.
HOSTINGER_MAIL_API_URL=

# Google OAuth (Google Cloud Console > Credentials > OAuth 2.0 Client ID)
# Authorized redirect URI must match GOOGLE_CALLBACK_URL exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_SECRET_KEY=
